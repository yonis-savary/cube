{
    "name": "yonis-savary/cube",
    "description": "Back-end web framework for PHP 8.5+",
    "keywords": ["php", "web", "framework", "backend"],
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Cube\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\": "tests/integration-root/App",
            "Tests\\": "tests/integration-root/Tests",
            "Cube\\Tests\\Units\\": "tests/units",
            "Cube\\Tests\\Integration\\": "tests/integration",
            "Cube\\Tests\\Apcu\\": "tests/apcu"
        }
    },
    "authors": [
        {
            "name": "yonis-savary",
            "email": "yonissavary@outlook.fr"
        }
    ],
    "minimum-stability": "dev",
    "require": {
        "php": "^8.5",
        "psr/log": "^3.0.2",
        "symfony/process": "^7.4",
        "cboden/ratchet": "^0.4.4",
        "react/http": "^1.10"
    },
    "require-dev": {
        "phpunit/phpunit": "13.3.6",
        "brianium/paratest": "7.25.0",
        "opis/json-schema": "2.6.0",
        "fakerphp/faker": "^1.24",
        "phpstan/phpstan": "^2.1"
    },
    "suggest": {
        "fakerphp/faker": "Required by model factories (Model::factory()) and OpenAPI examples (#[ResourceResponse])"
    },
    "prefer-stable": true
}
