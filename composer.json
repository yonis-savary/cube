{
    "name": "yonis-savary/cube",
    "description": "Simple Web Framework for PHP8+",
    "keywords": ["php", "web", "framework", "backend"],
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Cube\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\": "tests/integration-root/App",
            "Tests\\": "tests/integration-root/Tests",
            "Cube\\Tests\\Units\\": "tests/units",
            "Cube\\Tests\\Integration\\": "tests/integration",
            "Cube\\Tests\\Apcu\\": "tests/apcu"
        }
    },
    "authors": [
        {
            "name": "yonis-savary",
            "email": "yonissavary@outlook.fr"
        }
    ],
    "minimum-stability": "dev",
    "require": {
        "php": "^8.2",
        "psr/log": "^3.0.2",
        "symfony/process": "7.4.13",
        "cboden/ratchet": "^0.4.4",
        "react/http": "^1.10"
    },
    "require-dev": {
        "phpunit/phpunit": "13.3.1",
        "brianium/paratest": "7.24.0"
    },
    "prefer-stable": true
}
