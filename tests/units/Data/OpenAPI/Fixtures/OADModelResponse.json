{
    "openapi": "3.1.0",
    "info": {
        "title": "My Test Application",
        "version": "0.1.0"
    },
    "paths": {
        "\/products": {
            "get": {
                "summary": "endpointReturningAListOfProducts",
                "description": "SampleController.endpointReturningAListOfProducts",
                "operationId": "endpointReturningAListOfProducts",
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application\/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#\/components\/schemas\/Product"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "\/product\/{product}": {
            "get": {
                "summary": "endpointReturningAProduct",
                "description": "SampleController.endpointReturningAProduct",
                "operationId": "endpointReturningAProduct",
                "parameters": [
                    {
                        "name": "product",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application\/json": {
                                "schema": {
                                    "$ref": "#\/components\/schemas\/Product"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "Product": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": [
                            "integer",
                            "null"
                        ]
                    },
                    "created_at": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "format": "date-time"
                    },
                    "name": {
                        "type": "string"
                    },
                    "price_dollar": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "managers": {
                        "type": "array",
                        "items": {
                            "$ref": "#\/components\/schemas\/ProductManager"
                        }
                    }
                },
                "required": [
                    "name"
                ],
                "example": {
                    "price_dollar": "9.99000",
                    "id": 588,
                    "created_at": "2003-10-19 18:06:12",
                    "name": "natus sit consequatur"
                }
            },
            "ProductManager": {
                "type": "object",
                "properties": {
                    "product": {
                        "type": "integer"
                    },
                    "manager": {
                        "type": "string"
                    },
                    "_product": {
                        "oneOf": [
                            {
                                "$ref": "#\/components\/schemas\/Product"
                            },
                            {
                                "type": "null"
                            }
                        ]
                    }
                },
                "required": [
                    "product",
                    "manager"
                ],
                "example": {
                    "product": 838,
                    "manager": "soluta reiciendis aut"
                }
            }
        }
    }
}